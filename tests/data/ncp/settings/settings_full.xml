<NMSMPipelineDocument Version="1.5.4">
	<!--Every NCP option candidate-1.5.4 reads, with values different from the defaults where there is one:
	MTP results and osimx file, trial prefixes, v_max_factor, muscle groups, every optimizer option (note
	algorithm and finiteDifferenceType are camelCase), 20 B-spline nodes, sum normalization to 5,
	Muscle-Tendon Length Initialization enabled (its own RCNLCostTermSet comes before NCP's), every NCP cost
	term type (one disabled), and four synergies.-->
	<NeuralControlPersonalizationTool name="full">
		<results_directory>NCPResults</results_directory>
		<input_model_file>UF_Subject_3_reduced_muscles.osim</input_model_file>
		<input_osimx_file>mtpResults/UF_Subject_3_reduced_muscles_mtp.osimx</input_osimx_file>
		<data_directory>preprocessed</data_directory>
		<trial_prefixes>gait</trial_prefixes>
		<coordinate_list>hip_flexion_r knee_angle_r ankle_angle_r</coordinate_list>
		<v_max_factor>8</v_max_factor>
		<activation_muscle_groups>HipFlexorsActivationGroupR GlutmaxActivationGroupR HamslatActivationGroupR VasActivationGroupR GasActivationGroupR</activation_muscle_groups>
		<normalized_fiber_length_muscle_groups>GlutmaxNormalizedFiberLengthGroupR HamsNormalizedFiberLengthGroupR VasNormalizedFiberLengthGroupR GasNormalizedFiberLengthGroupR</normalized_fiber_length_muscle_groups>
		<diff_min_change>0.001</diff_min_change>
		<step_tolerance>1e-08</step_tolerance>
		<optimality_tolerance>1e-05</optimality_tolerance>
		<function_tolerance>1e-07</function_tolerance>
		<max_iterations>200</max_iterations>
		<max_function_evaluations>50000</max_function_evaluations>
		<algorithm>interior-point</algorithm>
		<finiteDifferenceType>forward</finiteDifferenceType>
		<number_of_nodes>20</number_of_nodes>
		<synergy_vector_normalization_method>sum</synergy_vector_normalization_method>
		<synergy_vector_normalization_value>5</synergy_vector_normalization_value>
		<optimize_synergy_vectors>true</optimize_synergy_vectors>
		<enforce_bilateral_symmetry>false</enforce_bilateral_symmetry>
		<MuscleTendonLengthInitialization>
			<is_enabled>true</is_enabled>
			<passive_data_input_directory>passive_moment_data</passive_data_input_directory>
			<max_normalized_muscle_fiber_length>1.05</max_normalized_muscle_fiber_length>
			<min_normalized_muscle_fiber_length>0.6</min_normalized_muscle_fiber_length>
			<optimize_maximum_muscle_stress>false</optimize_maximum_muscle_stress>
			<optimize_isometric_max_force>false</optimize_isometric_max_force>
			<maximum_muscle_stress>500000</maximum_muscle_stress>
			<RCNLCostTermSet>
				<RCNLCostTerm>
					<is_enabled>true</is_enabled>
					<type>passive_joint_moment</type>
					<max_allowable_error>2</max_allowable_error>
				</RCNLCostTerm>
			</RCNLCostTermSet>
		</MuscleTendonLengthInitialization>
		<mtp_results_directory>mtpResults</mtp_results_directory>
		<RCNLCostTermSet>
			<RCNLCostTerm>
				<is_enabled>true</is_enabled>
				<type>moment_tracking</type>
				<max_allowable_error>10</max_allowable_error>
			</RCNLCostTerm>
			<RCNLCostTerm>
				<is_enabled>true</is_enabled>
				<type>activation_tracking</type>
				<max_allowable_error>0.05</max_allowable_error>
			</RCNLCostTerm>
			<RCNLCostTerm>
				<is_enabled>false</is_enabled>
				<type>activation_minimization</type>
				<max_allowable_error>0.05</max_allowable_error>
			</RCNLCostTerm>
			<RCNLCostTerm>
				<is_enabled>true</is_enabled>
				<type>muscle_activation_minimization</type>
				<max_allowable_error>0.3</max_allowable_error>
				<error_center>0.1</error_center>
			</RCNLCostTerm>
			<RCNLCostTerm>
				<is_enabled>true</is_enabled>
				<type>synergy_activation_minimization</type>
				<max_allowable_error>0.5</max_allowable_error>
			</RCNLCostTerm>
			<RCNLCostTerm>
				<is_enabled>true</is_enabled>
				<type>grouped_activations</type>
				<max_allowable_error>0.1</max_allowable_error>
			</RCNLCostTerm>
			<RCNLCostTerm>
				<is_enabled>true</is_enabled>
				<type>grouped_fiber_lengths</type>
				<max_allowable_error>0.1</max_allowable_error>
			</RCNLCostTerm>
		</RCNLCostTermSet>
		<RCNLSynergySet>
			<RCNLSynergy name="right">
				<muscle_group_name>RightLeg</muscle_group_name>
				<num_synergies>4</num_synergies>
			</RCNLSynergy>
		</RCNLSynergySet>
	</NeuralControlPersonalizationTool>
</NMSMPipelineDocument>
