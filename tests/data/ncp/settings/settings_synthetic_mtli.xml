<NMSMPipelineDocument Version="1.5.4">
	<!--settings_synthetic_iliacus_hidden.xml with Muscle-Tendon Length Initialization enabled on the
	fixture passive data. In NCP, MTLI only updates muscles without MTP activations (here iliacus_r), so the
	passive data is real while the gait data is synthetic: this case checks the run, not a truth. Used by the
	regression tests.-->
	<NeuralControlPersonalizationTool name="synthetic_mtli">
		<results_directory>NCPResults</results_directory>
		<input_model_file>UF_Subject_3_reduced_muscles.osim</input_model_file>
		<input_osimx_file>mtpResults/UF_Subject_3_reduced_muscles_mtp.osimx</input_osimx_file>
		<data_directory>synthetic/iliacus_hidden/preprocessed</data_directory>
		<coordinate_list>hip_flexion_r knee_angle_r ankle_angle_r</coordinate_list>
		<activation_muscle_groups/>
		<normalized_fiber_length_muscle_groups/>
		<diff_min_change>0.0001</diff_min_change>
		<step_tolerance>1e-06</step_tolerance>
		<optimality_tolerance>1e-06</optimality_tolerance>
		<function_tolerance>1e-06</function_tolerance>
		<max_iterations>1000</max_iterations>
		<MuscleTendonLengthInitialization>
			<is_enabled>true</is_enabled>
			<passive_data_input_directory>passive_moment_data</passive_data_input_directory>
			<optimize_maximum_muscle_stress>false</optimize_maximum_muscle_stress>
			<optimize_isometric_max_force>false</optimize_isometric_max_force>
			<RCNLCostTermSet>
				<RCNLCostTerm>
					<is_enabled>true</is_enabled>
					<type>passive_joint_moment</type>
					<max_allowable_error>2</max_allowable_error>
				</RCNLCostTerm>
			</RCNLCostTermSet>
		</MuscleTendonLengthInitialization>
		<mtp_results_directory>synthetic/iliacus_hidden/mtpResults</mtp_results_directory>
		<RCNLCostTermSet>
			<RCNLCostTerm>
				<is_enabled>true</is_enabled>
				<type>moment_tracking</type>
				<max_allowable_error>10</max_allowable_error>
			</RCNLCostTerm>
			<RCNLCostTerm>
				<is_enabled>true</is_enabled>
				<type>activation_tracking</type>
				<max_allowable_error>0.05</max_allowable_error>
			</RCNLCostTerm>
		</RCNLCostTermSet>
		<RCNLSynergySet>
			<RCNLSynergy>
				<muscle_group_name>RightLeg</muscle_group_name>
				<num_synergies>3</num_synergies>
			</RCNLSynergy>
		</RCNLSynergySet>
	</NeuralControlPersonalizationTool>
</NMSMPipelineDocument>
