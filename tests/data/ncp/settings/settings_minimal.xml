<NMSMPipelineDocument Version="1.5.4">
	<!--Only the elements the candidate-1.5.4 parser requires: no MTP results (mtp_results_directory is
	optional), empty muscle group lists, MTLI disabled, one cost term and one synergy group. The base for
	every bad_* and edge_* file.-->
	<NeuralControlPersonalizationTool name="minimal">
		<results_directory>NCPResults</results_directory>
		<input_model_file>UF_Subject_3_reduced_muscles.osim</input_model_file>
		<input_osimx_file/>
		<data_directory>preprocessed</data_directory>
		<coordinate_list>hip_flexion_r knee_angle_r ankle_angle_r</coordinate_list>
		<activation_muscle_groups/>
		<normalized_fiber_length_muscle_groups/>
		<MuscleTendonLengthInitialization>
			<is_enabled>false</is_enabled>
		</MuscleTendonLengthInitialization>
		<RCNLCostTermSet>
			<RCNLCostTerm>
				<is_enabled>true</is_enabled>
				<type>moment_tracking</type>
				<max_allowable_error>10</max_allowable_error>
			</RCNLCostTerm>
		</RCNLCostTermSet>
		<RCNLSynergySet>
			<RCNLSynergy>
				<muscle_group_name>RightLeg</muscle_group_name>
				<num_synergies>3</num_synergies>
			</RCNLSynergy>
		</RCNLSynergySet>
	</NeuralControlPersonalizationTool>
</NMSMPipelineDocument>
