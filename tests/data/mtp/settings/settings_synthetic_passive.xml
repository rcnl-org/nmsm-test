<NMSMPipelineDocument Version="1.5.4">
	<!--Synthetic known-truth Muscle-Tendon Length Initialization case (see tests/data/mtp/README.md): the
	synthetic/passive data, passive moments computed at true optimal fiber and tendon slack length scale
	factors. Passive moment tracking is the only cost; maximum isometric force and muscle stress are
	fixed. MTLI runs inside the MTP tool, so MTP runs after it on the real gait data, but only for one
	iteration and without optimizing lengths: the length scale factors MTP reports are then exactly
	MTLI's. Used by the regression tests.-->
	<MuscleTendonPersonalizationTool name="synthetic_passive">
		<results_directory>MTPResults</results_directory>
		<input_model_file>UF_Subject_3_reduced_muscles.osim</input_model_file>
		<input_osimx_file/>
		<data_directory>preprocessed</data_directory>
		<coordinate_list>hip_flexion_r knee_angle_r ankle_angle_r</coordinate_list>
		<activation_muscle_groups/>
		<normalized_fiber_length_muscle_groups/>
		<collected_emg_channel_muscle_groups>GlutMaxLat RecFem BicFemLong BicFemShort VastMed GasMed Sol TibAnt</collected_emg_channel_muscle_groups>
		<max_iterations>1</max_iterations>
		<MuscleTendonLengthInitialization>
			<is_enabled>true</is_enabled>
			<passive_data_input_directory>synthetic/passive</passive_data_input_directory>
			<optimize_maximum_muscle_stress>false</optimize_maximum_muscle_stress>
			<optimize_isometric_max_force>false</optimize_isometric_max_force>
			<RCNLCostTermSet>
				<RCNLCostTerm>
					<is_enabled>true</is_enabled>
					<type>passive_joint_moment</type>
					<max_allowable_error>2</max_allowable_error>
				</RCNLCostTerm>
			</RCNLCostTermSet>
		</MuscleTendonLengthInitialization>
		<MTPSynergyExtrapolation>
			<is_enabled>false</is_enabled>
		</MTPSynergyExtrapolation>
		<MTPTaskList>
			<MTPTask>
				<is_enabled>true</is_enabled>
				<muscle_specific_electromechanical_delays>true</muscle_specific_electromechanical_delays>
				<optimize_optimal_fiber_lengths>false</optimize_optimal_fiber_lengths>
				<optimize_tendon_slack_lengths>false</optimize_tendon_slack_lengths>
				<RCNLCostTermSet>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>inverse_dynamics_joint_moment</type>
						<max_allowable_error>2.5</max_allowable_error>
					</RCNLCostTerm>
				</RCNLCostTermSet>
			</MTPTask>
		</MTPTaskList>
	</MuscleTendonPersonalizationTool>
</NMSMPipelineDocument>
