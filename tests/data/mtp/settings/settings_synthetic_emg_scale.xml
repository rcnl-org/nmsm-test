<NMSMPipelineDocument Version="1.5.4">
	<!--Synthetic known-truth case (see tests/data/mtp/README.md): the synthetic model and the emg_scale data,
	computed at true EMG scale factors with every other parameter at MTP's starting values. Only EMG
	scale factors are optimized, with moment tracking as the only cost. Synergy extrapolation and
	Muscle-Tendon Length Initialization are disabled. Used by the regression tests.-->
	<MuscleTendonPersonalizationTool name="synthetic_emg_scale">
		<results_directory>MTPResults</results_directory>
		<input_model_file>synthetic/UF_Subject_3_reduced_muscles_synthetic.osim</input_model_file>
		<input_osimx_file/>
		<data_directory>synthetic/emg_scale</data_directory>
		<coordinate_list>hip_flexion_r knee_angle_r ankle_angle_r</coordinate_list>
		<activation_muscle_groups/>
		<normalized_fiber_length_muscle_groups/>
		<collected_emg_channel_muscle_groups>GlutMaxLat RecFem BicFemLong BicFemShort VastMed GasMed Sol TibAnt</collected_emg_channel_muscle_groups>
		<max_iterations>1000</max_iterations>
		<MuscleTendonLengthInitialization>
			<is_enabled>false</is_enabled>
		</MuscleTendonLengthInitialization>
		<MTPSynergyExtrapolation>
			<is_enabled>false</is_enabled>
		</MTPSynergyExtrapolation>
		<MTPTaskList>
			<MTPTask>
				<is_enabled>true</is_enabled>
				<muscle_specific_electromechanical_delays>true</muscle_specific_electromechanical_delays>
				<optimize_electromechanical_delays>false</optimize_electromechanical_delays>
				<optimize_activation_time_constants>false</optimize_activation_time_constants>
				<optimize_activation_nonlinearity_constants>false</optimize_activation_nonlinearity_constants>
				<optimize_emg_scale_factors>true</optimize_emg_scale_factors>
				<optimize_optimal_fiber_lengths>false</optimize_optimal_fiber_lengths>
				<optimize_tendon_slack_lengths>false</optimize_tendon_slack_lengths>
				<RCNLCostTermSet>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>inverse_dynamics_joint_moment</type>
						<max_allowable_error>2.5</max_allowable_error>
					</RCNLCostTerm>
				</RCNLCostTermSet>
			</MTPTask>
		</MTPTaskList>
	</MuscleTendonPersonalizationTool>
</NMSMPipelineDocument>
