<NMSMPipelineDocument Version="1.5.4">
	<!--Synthetic known-truth case (see tests/data/gcp/README.md): the data of settings_synthetic_springs.xml,
	with the spring constants kept near their neighbors instead of their mean, and without a moment cost term
	(the moment terms are what makes GCP compute the spring positions the neighbor term needs). Used by the
	regression tests.-->
	<GroundContactPersonalizationTool name="synthetic_neighbor">
		<results_directory>GCPResults</results_directory>
		<input_directory>synthetic/springs</input_directory>
		<input_model_file>bodyModel.osim</input_model_file>
		<input_osimx_file/>
		<input_motion_file>IKData/gait_1.sto</input_motion_file>
		<input_grf_file>GRFData/gait_1.sto</input_grf_file>
		<kinematics_filter_cutoff>10</kinematics_filter_cutoff>
		<initialize_resting_spring_length>false</initialize_resting_spring_length>
		<grid_width>5</grid_width>
		<grid_height>11</grid_height>
		<GCPContactSurfaceSet>
			<GCPContactSurface name="Right foot">
				<is_enabled>true</is_enabled>
				<is_left_foot>false</is_left_foot>
				<start_time>0.5</start_time>
				<end_time>1.6</end_time>
				<belt_speed>1.4</belt_speed>
				<force_columns>ground_force_2_vx ground_force_2_vy ground_force_2_vz</force_columns>
				<moment_columns>ground_moment_2_mx ground_moment_2_my ground_moment_2_mz</moment_columns>
				<electrical_center_columns>ground_force_2_px ground_force_2_py ground_force_2_pz</electrical_center_columns>
				<hindfoot_body>calcn_r</hindfoot_body>
				<toe_marker>R_Toe</toe_marker>
				<medial_marker>R_Toe_Medial</medial_marker>
				<lateral_marker>R_Toe_Lateral</lateral_marker>
				<heel_marker>R_Heel</heel_marker>
				<midfoot_superior_marker>R_Midfoot_Superior</midfoot_superior_marker>
			</GCPContactSurface>
		</GCPContactSurfaceSet>
		<GCPTaskList>
			<GCPTask>
				<is_enabled>true</is_enabled>
				<springConstants>true</springConstants>
				<dampingFactor>true</dampingFactor>
				<dynamicFrictionCoefficient>true</dynamicFrictionCoefficient>
				<restingSpringLength>true</restingSpringLength>
				<RCNLCostTermSet>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>vertical_grf</type>
						<max_allowable_error>5</max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>horizontal_grf</type>
						<max_allowable_error>2</max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>neighbor_spring_constant</type>
						<max_allowable_error>50</max_allowable_error>
					</RCNLCostTerm>
				</RCNLCostTermSet>
			</GCPTask>
		</GCPTaskList>
		<initial_resting_spring_length>0.05</initial_resting_spring_length>
		<initial_spring_constant>2500</initial_spring_constant>
		<initial_damping_factor>1</initial_damping_factor>
		<initial_dynamic_friction_coefficient>0.5</initial_dynamic_friction_coefficient>
		<initial_viscous_friction_coefficient>0</initial_viscous_friction_coefficient>
		<latching_velocity>0.1</latching_velocity>
		<diff_min_change>0.0001</diff_min_change>
		<step_tolerance>1e-08</step_tolerance>
		<optimality_tolerance>1e-08</optimality_tolerance>
		<function_tolerance>1e-08</function_tolerance>
		<max_iterations>50</max_iterations>
	</GroundContactPersonalizationTool>
</NMSMPipelineDocument>
