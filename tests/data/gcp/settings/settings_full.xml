<NMSMPipelineDocument Version="1.5.4">
	<!--Every GCP option candidate-1.5.4 reads, with values different from the defaults where there is one:
	kinematics filter cutoff, latching velocity, grid size, no resting spring length initialization, every
	initial value, every optimizer option, and three tasks listed out of index order (2, 3, 1) with task 3
	disabled. Task 1 turns on every design variable and every cost term type (with electrical center
	regularization limited to the x and z axes); task 2 leaves the design variables at their defaults (off)
	apart from spring constants.-->
	<GroundContactPersonalizationTool name="full">
		<results_directory>GCPResults</results_directory>
		<input_directory>preprocessed</input_directory>
		<input_model_file>bodyModel.osim</input_model_file>
		<input_osimx_file/>
		<input_motion_file>IKData/gait_1.sto</input_motion_file>
		<input_grf_file>GRFData/gait_1.sto</input_grf_file>
		<kinematics_filter_cutoff>8</kinematics_filter_cutoff>
		<latching_velocity>0.2</latching_velocity>
		<grid_width>6</grid_width>
		<grid_height>12</grid_height>
		<initialize_resting_spring_length>false</initialize_resting_spring_length>
		<initial_resting_spring_length>0.04</initial_resting_spring_length>
		<initial_spring_constant>3000</initial_spring_constant>
		<initial_damping_factor>0.5</initial_damping_factor>
		<initial_dynamic_friction_coefficient>0.6</initial_dynamic_friction_coefficient>
		<initial_viscous_friction_coefficient>2</initial_viscous_friction_coefficient>
		<diff_min_change>0.001</diff_min_change>
		<step_tolerance>1e-05</step_tolerance>
		<optimality_tolerance>1e-05</optimality_tolerance>
		<function_tolerance>1e-05</function_tolerance>
		<max_iterations>30</max_iterations>
		<max_function_evaluations>10000</max_function_evaluations>
		<GCPContactSurfaceSet>
			<GCPContactSurface name="Right foot">
				<is_enabled>true</is_enabled>
				<is_left_foot>false</is_left_foot>
				<start_time>0.6</start_time>
				<end_time>1.5</end_time>
				<belt_speed>1.2</belt_speed>
				<force_columns>ground_force_2_vx ground_force_2_vy ground_force_2_vz</force_columns>
				<moment_columns>ground_moment_2_mx ground_moment_2_my ground_moment_2_mz</moment_columns>
				<electrical_center_columns>ground_force_2_px ground_force_2_py ground_force_2_pz</electrical_center_columns>
				<hindfoot_body>calcn_r</hindfoot_body>
				<toe_marker>R_Toe</toe_marker>
				<medial_marker>R_Toe_Medial</medial_marker>
				<lateral_marker>R_Toe_Lateral</lateral_marker>
				<heel_marker>R_Heel</heel_marker>
				<midfoot_superior_marker>R_Midfoot_Superior</midfoot_superior_marker>
			</GCPContactSurface>
		</GCPContactSurfaceSet>
		<GCPTaskList>
			<GCPTask>
				<is_enabled>true</is_enabled>
				<index>2</index>
				<springConstants>true</springConstants>
				<RCNLCostTermSet>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>vertical_grf</type>
						<max_allowable_error>4</max_allowable_error>
					</RCNLCostTerm>
				</RCNLCostTermSet>
			</GCPTask>
			<GCPTask>
				<is_enabled>false</is_enabled>
				<index>3</index>
				<springConstants>true</springConstants>
				<RCNLCostTermSet>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>vertical_grf</type>
						<max_allowable_error>3</max_allowable_error>
					</RCNLCostTerm>
				</RCNLCostTermSet>
			</GCPTask>
			<GCPTask>
				<is_enabled>true</is_enabled>
				<index>1</index>
				<springConstants>true</springConstants>
				<dampingFactor>true</dampingFactor>
				<dynamicFrictionCoefficient>true</dynamicFrictionCoefficient>
				<viscousFrictionCoefficient>true</viscousFrictionCoefficient>
				<restingSpringLength>true</restingSpringLength>
				<kinematicsBSplineCoefficients>true</kinematicsBSplineCoefficients>
				<electricalCenterX>true</electricalCenterX>
				<electricalCenterY>true</electricalCenterY>
				<electricalCenterZ>true</electricalCenterZ>
				<forcePlateRotation>true</forcePlateRotation>
				<neighborStandardDeviation>0.1</neighborStandardDeviation>
				<RCNLCostTermSet>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>marker_position</type>
						<max_allowable_error>0.002</max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>marker_slope</type>
						<max_allowable_error>0.05</max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>rotation</type>
						<max_allowable_error>0.005</max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>translation</type>
						<max_allowable_error>0.002</max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>kinematic_periodicity</type>
						<max_allowable_error>1</max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>vertical_grf</type>
						<max_allowable_error>5</max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>vertical_grf_slope</type>
						<max_allowable_error>200</max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>horizontal_grf</type>
						<max_allowable_error>2</max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>horizontal_grf_slope</type>
						<max_allowable_error>100</max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>ground_reaction_moment</type>
						<max_allowable_error>0.5</max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>ground_reaction_moment_slope</type>
						<max_allowable_error>20</max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>spring_constant_mean</type>
						<max_allowable_error>1000</max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>neighbor_spring_constant</type>
						<max_allowable_error>500</max_allowable_error>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>true</is_enabled>
						<type>electrical_center_regularization</type>
						<max_allowable_error>0.01</max_allowable_error>
						<axes>xz</axes>
					</RCNLCostTerm>
					<RCNLCostTerm>
						<is_enabled>false</is_enabled>
						<type>force_plate_rotation_regularization</type>
						<max_allowable_error>0.05</max_allowable_error>
					</RCNLCostTerm>
				</RCNLCostTermSet>
			</GCPTask>
		</GCPTaskList>
	</GroundContactPersonalizationTool>
</NMSMPipelineDocument>
