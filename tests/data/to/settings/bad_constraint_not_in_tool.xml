<NMSMPipelineDocument Version="1.5.4">
	<!--settings_tracking_torque_minimal.xml with one change: an enabled limit_normalized_fiber_length constraint, which only Design Optimization allows.-->
	<TrackingOptimizationTool name="minimal">
		<results_directory>TrackingResults</results_directory>
		<initial_guess_directory>preprocessed</initial_guess_directory>
		<tracked_quantities_directory>preprocessed</tracked_quantities_directory>
		<input_model_file>KickingModel.osim</input_model_file>
		<optimal_control_solver_settings_file>gpops_torque_tutorial.xml</optimal_control_solver_settings_file>
		<trial_name>drive_kick1</trial_name>
		<states_coordinate_list>hip_flexion_r knee_angle_r ankle_angle_r</states_coordinate_list>
		<RCNLTorqueController>
			<coordinate_list>hip_flexion_r knee_angle_r ankle_angle_r</coordinate_list>
		</RCNLTorqueController>
		<RCNLCostTermSet/>
		<RCNLConstraintTermSet>
			<RCNLConstraintTerm>
				<is_enabled>true</is_enabled>
				<type>limit_normalized_fiber_length</type>
			</RCNLConstraintTerm>
		</RCNLConstraintTermSet>
	</TrackingOptimizationTool>
</NMSMPipelineDocument>
