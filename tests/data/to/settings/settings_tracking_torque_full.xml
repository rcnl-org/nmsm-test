<NMSMPipelineDocument Version="1.5.4">
	<!--Every general Treatment Optimization option candidate-1.5.4 reads, for a torque-driven Tracking Optimization,
	mostly with values different from the defaults: every range scale factor and minimum range, the torque control
	range settings, normalization by term type, and cost and constraint terms that use lists (split into one term per
	entry), axes (split per axis), time ranges, scale factors, error centers, values instead of errors, and a disabled
	term.-->
	<TrackingOptimizationTool name="full">
		<results_directory>TrackingResults</results_directory>
		<initial_guess_directory>preprocessed</initial_guess_directory>
		<tracked_quantities_directory>preprocessed</tracked_quantities_directory>
		<input_model_file>KickingModel.osim</input_model_file>
		<input_osimx_file/>
		<optimal_control_solver_settings_file>gpops_torque_tutorial.xml</optimal_control_solver_settings_file>
		<trial_name>drive_kick1</trial_name>
		<normalize_cost_by_term_type>true</normalize_cost_by_term_type>
		<states_coordinate_list>hip_flexion_r knee_angle_r ankle_angle_r</states_coordinate_list>
		<joint_position_range_scale_factor>1.5</joint_position_range_scale_factor>
		<joint_velocity_range_scale_factor>1.25</joint_velocity_range_scale_factor>
		<joint_acceleration_range_scale_factor>0.5</joint_acceleration_range_scale_factor>
		<joint_position_minimum_range>0.1</joint_position_minimum_range>
		<joint_velocity_minimum_range>0.2</joint_velocity_minimum_range>
		<joint_acceleration_minimum_range>0.3</joint_acceleration_minimum_range>
		<RCNLTorqueController>
			<coordinate_list>hip_flexion_r knee_angle_r ankle_angle_r</coordinate_list>
			<torque_controls_range_scale_factor>2</torque_controls_range_scale_factor>
			<torque_controls_minimum_range>5</torque_controls_minimum_range>
		</RCNLTorqueController>
		<RCNLCostTermSet>
			<RCNLCostTerm>
				<is_enabled>true</is_enabled>
				<type>generalized_coordinate_tracking</type>
				<coordinate_list>hip_flexion_r knee_angle_r ankle_angle_r</coordinate_list>
				<max_allowable_error>0.0873</max_allowable_error>
			</RCNLCostTerm>
			<RCNLCostTerm>
				<is_enabled>true</is_enabled>
				<type>inverse_dynamics_load_tracking</type>
				<load_list>hip_flexion_r_moment knee_angle_r_moment</load_list>
				<max_allowable_error>50</max_allowable_error>
				<time_ranges>0 0.5</time_ranges>
				<scale_factor>0.9</scale_factor>
				<normalize_by_final_time>false</normalize_by_final_time>
			</RCNLCostTerm>
			<RCNLCostTerm>
				<is_enabled>true</is_enabled>
				<type>generalized_speed_minimization</type>
				<coordinate_list>ankle_angle_r</coordinate_list>
				<max_allowable_error>10</max_allowable_error>
				<error_center>1</error_center>
			</RCNLCostTerm>
			<RCNLCostTerm>
				<is_enabled>true</is_enabled>
				<type>body_orientation_tracking</type>
				<body_list>calcn_r</body_list>
				<axes>xz</axes>
				<sequence>xyz</sequence>
				<max_allowable_error>0.1</max_allowable_error>
			</RCNLCostTerm>
			<RCNLCostTerm>
				<is_enabled>false</is_enabled>
				<type>controller_minimization</type>
				<controller_list>hip_flexion_r</controller_list>
				<max_allowable_error>100</max_allowable_error>
			</RCNLCostTerm>
		</RCNLCostTermSet>
		<RCNLConstraintTermSet>
			<RCNLConstraintTerm>
				<is_enabled>true</is_enabled>
				<type>kinetic_consistency</type>
				<load_list>hip_flexion_r_moment knee_angle_r_moment ankle_angle_r_moment</load_list>
				<max_error>0.1</max_error>
				<min_error>-0.1</min_error>
			</RCNLConstraintTerm>
			<RCNLConstraintTerm>
				<is_enabled>true</is_enabled>
				<type>generalized_coordinate_value</type>
				<coordinate_list>ankle_angle_r</coordinate_list>
				<max_value>0.5</max_value>
				<min_value>-0.5</min_value>
			</RCNLConstraintTerm>
			<RCNLConstraintTerm>
				<is_enabled>true</is_enabled>
				<type>generalized_coordinate_periodicity</type>
				<coordinate_list>knee_angle_r</coordinate_list>
				<max_error>0.01</max_error>
				<min_error>-0.02</min_error>
			</RCNLConstraintTerm>
		</RCNLConstraintTermSet>
	</TrackingOptimizationTool>
</NMSMPipelineDocument>
