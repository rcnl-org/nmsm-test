<NMSMPipelineDocument Version="1.5.4">
	<!--Torque-driven Design Optimization of the walking gait cycle, starting from and tracking the tutorial's published Tracking results (published/WalkingTOResults, 101 points). See settings_tracking_walking.xml.-->
	<DesignOptimizationTool name="default">
		<!--Directory used for writing results.-->
		<results_directory>DesignResults</results_directory>
		<!--Directory for optimizer initial guess.-->
		<initial_guess_directory>published/WalkingTOResults</initial_guess_directory>
		<!--Directory for files for the optimizer to track.-->
		<tracked_quantities_directory>published/WalkingTOResults</tracked_quantities_directory>
		<!--Name of the input model file (.osim) to use.-->
		<input_model_file>Full_Body_Walking_Model-Post_JMP.osim</input_model_file>
		<!--Name of the osimx model file, which holds the GCP contact surfaces.-->
		<input_osimx_file>Full_Body_Walking_Model-Post_GCP.osimx</input_osimx_file>
		<!--Name of the optimal control solver settings file.-->
		<optimal_control_solver_settings_file>gpops_small.xml</optimal_control_solver_settings_file>
		<!--Name, excluding file type (.sto, .mot, etc), of the trial-->
		<trial_name>Trial12_Gait</trial_name>
		<!--Space separated list of coordinates to be considered GPOPS2 states. Not including a coordinate prescribes it.-->
		<states_coordinate_list>pelvis_tilt pelvis_list pelvis_rotation pelvis_tx pelvis_ty pelvis_tz hip_flexion_r hip_adduction_r hip_rotation_r knee_angle_r ankle_angle_r subtalar_angle_r mtp_angle_r hip_flexion_l hip_adduction_l hip_rotation_l knee_angle_l ankle_angle_l subtalar_angle_l mtp_angle_l lumbar_extension lumbar_bending lumbar_rotation arm_flex_r arm_add_r arm_rot_r elbow_flex_r arm_flex_l arm_add_l arm_rot_l elbow_flex_l</states_coordinate_list>
		<!--*Optional* Default is 2.-->
		<joint_position_range_scale_factor>1.5</joint_position_range_scale_factor>
		<!--*Optional* Default is 1.5.-->
		<joint_velocity_range_scale_factor>1.25</joint_velocity_range_scale_factor>
		<!--*Optional* Default is 1.-->
		<joint_acceleration_range_scale_factor>1</joint_acceleration_range_scale_factor>
		<!--Set of torque controls for GPOPS2.-->
		<RCNLTorqueController>
			<!--Space separated list containing the coordinates controlled by the torque controller.-->
			<coordinate_list>hip_flexion_r hip_adduction_r hip_rotation_r knee_angle_r ankle_angle_r subtalar_angle_r hip_flexion_l hip_adduction_l hip_rotation_l knee_angle_l ankle_angle_l subtalar_angle_l</coordinate_list>
		</RCNLTorqueController>
		<!--Set of cost terms used for this optimization.-->
		<RCNLCostTermSet>
			<RCNLCostTerm name="Controller tracking">
				<is_enabled>true</is_enabled>
				<type>controller_tracking</type>
				<controller_list>hip_flexion_r hip_adduction_r hip_rotation_r knee_angle_r ankle_angle_r subtalar_angle_r hip_flexion_l hip_adduction_l hip_rotation_l knee_angle_l ankle_angle_l subtalar_angle_l</controller_list>
				<max_allowable_error>50</max_allowable_error>
			</RCNLCostTerm>
		</RCNLCostTermSet>
		<!--Set of constraint terms applied to this optimization.-->
		<RCNLConstraintTermSet>
			<RCNLConstraintTerm name="Root segment residual moments">
				<type>root_segment_residual_load</type>
				<is_enabled>true</is_enabled>
				<load_list>pelvis_tilt_moment pelvis_list_moment pelvis_rotation_moment</load_list>
				<max_error>1</max_error>
				<min_error>-1</min_error>
			</RCNLConstraintTerm>
		</RCNLConstraintTermSet>
	</DesignOptimizationTool>
</NMSMPipelineDocument>
